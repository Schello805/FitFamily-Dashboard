<plist version="1.0"><dict><key>WFWorkflowName</key><string>FitFamily Health Vergleich</string>
<key>WFWorkflowActions</key><array><dict><key>WFWorkflowActionIdentifier</key><string>is.workflow.actions.comment</string>
