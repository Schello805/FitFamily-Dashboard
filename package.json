{
  "name": "fitfamily-dashboard",
  "version": "0.2.75",
  "private": true,
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "update": "bash scripts/update.sh",
    "repair": "bash scripts/repair.sh",
    "kiosk:setup": "bash scripts/setup-kiosk-autostart.sh",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "bcryptjs": "3.0.3",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
