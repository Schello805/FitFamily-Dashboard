# Die echte Datei .env.local bleibt ausschließlich auf dem Gerät, auf dem FitFamily läuft.
DATABASE_URL=file:./data/fitfamily.db
# Optional: feste, vom Handy erreichbare Adresse für Einrichtungs-QR (z. B. http://192.168.1.42:3000).
# Wenn leer, wird automatisch die Host-Adresse dieser Dashboard-Anfrage verwendet.
APP_URL=
SESSION_SECRET=change-me-with-at-least-32-random-characters
OPENAI_API_KEY=
GEMINI_API_KEY=
NAS_BACKUP_PATH=
